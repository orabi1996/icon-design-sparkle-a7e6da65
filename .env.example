# ==============================================================================
# HRMS Staging Environment Variables Template
# DO NOT COMMIT SENSITIVE VALUES TO VERSION CONTROL
# Copy this file to .env.local and populate with your staging project credentials
# ==============================================================================

# Supabase Client Configuration (Vite Public)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Supabase Server Configuration (Never expose to client bundles)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Encryption Key for sensitive database credentials (e.g. SMTP password at rest)
EMAIL_CONFIG_ENCRYPTION_KEY=your_32_byte_encryption_key_here
